px;font-weight:700">Oftalmologia</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Examês de vista, cirurgia refrativa, lentes</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center;transition:all.3s"><div style="font-size:36px;margin-bottom:8px"></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Ginecologia</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Preventivo, examês, planejamento familiar</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center;transition:all.3s"><div style="font-size:36px;margin-bottom:8px"></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Pediatria</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Consultas infantis, vacinas, crescimento</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center;transition:all.3s"><div style="font-size:36px;margin-bottom:8px"></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Pneumologia</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Espirometria, alergias, doencas respiratorias</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center;transition:all.3s"><div style="font-size:36px;margin-bottom:8px"></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Dermatologia</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Consulta dermatologica, examês de pele, cirurgia</p></div></div></div><div style="margin-bottom:32px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px"><h3 style="font-family:var(--fp);font-size:18px;font-weight:700;margin-bottom:16px">Tabela de Serviços e Preços</h3><div