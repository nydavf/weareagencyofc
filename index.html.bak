 extraHTML:'<div class="pg-section" style="--accent-color:#818cf8"><div style="text-align:center;padding:12px;margin-bottom:20px;background:rgba(#818cf8,0.1);border:1px dashed #818cf8;border-radius:10px;font-size:13px;color:#818cf8"><i class="fas fa-info-circle"></i> Este e um exemplo de site institucional � conteúdo ilustrativo.</div><div style="margin-bottom:32px"><h3 style="font-family:var(--fp);font-size:20px;font-weight:700;margin-bottom:16px">Nossos Serviços</h3><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px"><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center;transition:all.3s"><div style="width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#818cf8,#4f46e5);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;color:#fff"><i class="fas fa-globe"></i></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Sites Institucionais</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Presença digital profissional para sua empresa</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center;transition:all.3s"><div style="width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#818cf8,#4f46e5);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;color:#fff"><i class="fas fa-shopping-cart"></i></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">E-commerce</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Loja virtual completa com gestão de produtos</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center;transition:all.3s"><div style="width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#818cf8,#4f46e5);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;color:#fff"><i class="fas fa-paint-brush"></i></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Design Gráfico</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Identidade visual, logos, materiais impressos</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center;transition:all.3s"><div style="width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#818cf8,#4f46e5);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;color:#fff"><i class="fas fa-search"></i></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">SEO & Marketing</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Otimização para mecanismos de busca e tráfego</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center;transition:all.3s"><div style="width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#818cf8,#4f46e5);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;color:#fff"><i class="fas fa-mobile-alt"></i></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Aplicativos Mobile</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Apps nativos para iOS e Android</p></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center;transition:all.3s"><div style="width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#818cf8,#4f46e5);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;color:#fff"><i class="fas fa-headset"></i></div><h4 style="font-family:var(--fp);font-size:15px;font-weight:700">Suporte Tecnico</h4><p style="font-size:12px;color:var(--text-muted);margin:6px 0">Manutenção, hospedagem e suporte contínuo</p></div></div></div><div style="margin-bottom:32px"><h3 style="font-family:var(--fp);font-size:20px;font-weight:700;margin-bottom:16px">Cases de Sucesso</h3><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px"><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:all.3s"><img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&q=80" style="width:100%;height:180px;object-fit:cover" /><div style="padding:16px"><div style="font-family:var(--fp);font-weight:700;font-size:15px;margin-bottom:4px">TechStore</div><p style="font-size:12px;color:var(--text-muted);margin-bottom:8px">E-commerce de eletrônicos que aumentou as vendas em 200% com nosso catálogo digital.</p><div style="font-size:11px;color:#818cf8;font-weight:600">Site Institucional + E-commerce</div></div></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:all.3s"><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&q=80" style="width:100%;height:180px;object-fit:cover" /><div style="padding:16px"><div style="font-family:var(--fp);font-weight:700;font-size:15px;margin-bottom:4px">Clinica Saúde+</div><p style="font-size:12px;color:var(--text-muted);margin-bottom:8px">Portal de saúde que triplicou o número de agendamentos online.</p><div style="font-size:11px;color:#818cf8;font-weight:600">Portal + Agendamento Online</div></div></div><div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:all.3s"><img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&q=80" style="width:100%;height:180px;object-fit:cover" /><div style="padding:16px"><div style="font-family:var(--fp);font-weight:700;font-size:15px;margin-bottom:4px">Restaurante Sabor & Arte</div><p style="font-size:12px;color:var(--text-muted);margin-bottom:8px">Cardápio digital que gerou mais de 500 pedidos no primeiro mês.</p><div style="font-size:11px;color:#818cf8;font-weight:600">Cardápio Digital + Integração WhatsApp</div></div></div></div></div><div style="margin-bottom:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px"><h3 style="font-family:var(--fp);font-size:18px;font-weight:700;margin-bottom:16px">Pacotes de Serviços</h3><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px"><div style="background:var(--glass);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center"><h4 style="font-size:16px;font-weight:700;margin-bottom:8px">Básico</h4><div style="font-family:var(--fp);font-size:28px;font-weight:800;color:#818cf8">R$ 1.000</div><ul style="list-style:none;margin:12px 0;text-align:left"><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Site institucional</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Design responsivo</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>SEO básico</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Suporte 30 dias</li></ul></div><div style="background:var(--glass);border:2px solid #818cf8;border-radius:var(--radius);padding:20px;text-align:center;position:relative"><span style="position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#818cf8;color:#fff;font-size:10px;font-weight:700;padding:3px 12px;border-radius:50px">POPULAR</span><h4 style="font-size:16px;font-weight:700;margin-bottom:8px">Profissional</h4><div style="font-family:var(--fp);font-size:28px;font-weight:800;color:#818cf8">R$ 1.250</div><ul style="list-style:none;margin:12px 0;text-align:left"><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Tudo do Básico</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Catálogo de produtos</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Painel administrativo</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Integração WhatsApp</li></ul></div><div style="background:var(--glass);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center"><h4 style="font-size:16px;font-weight:700;margin-bottom:8px">Premium</h4><div style="font-family:var(--fp);font-size:28px;font-weight:800;color:#818cf8">R$ 1.500</div><ul style="list-style:none;margin:12px 0;text-align:left"><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Tudo do Profissional</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Sistema de agendamento</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Galeria avançada</li><li style="padding:4px 0;font-size:12px;color:var(--text-muted)"><i class="fas fa-check" style="color:#818cf8;margin-right:6px"></i>Suporte prioritário</li></ul></div></div></div></div>',
 testimonials:[{s:'A We Are entregou um site institucional que superou todas as expectativas.Profissionalismo total.',a:'Marcos Vieira'},{s:'O catálogo de serviços no site facilitou muito o entendimento dos clientes.Resultado imediato!',a:'Luciana Pires'}]
 }
 ];

 function init(){
 hideLoading(); initParticles(); initNavbar(); initScrollReveal();
 renderServices(); initPortfolio(); initPaymentPopup(); initCopyPix();
 initSettings(); initDarkMode(); initContactForm(); initFaq(); initBackTop();
 }

 function hideLoading(){window.addEventListener('load',function(){setTimeout(function(){document.getElementById('loading').classList.add('hide')},2000)})}
 function initParticles(){
 var c=document.getElementById('particles-canvas');if(!c)return;var ctx=c.getContext('2d'),arr=[],mx=0,my=0;
 function resize(){c.width=c.parentElement.offsetWidth;c.height=c.parentElement.offsetHeight}resize();window.addEventListener('resize',resize);
 function P(){this.x=Math.random()*c.width;this.y=Math.random()*c.height;this.s=Math.random()*2+1;this.vx=(Math.random()-0.5)*0.5;this.vy=(Math.random()-0.5)*0.5;this.o=Math.random()*0.5+0.1}
 P.prototype.update=function(){this.x+=this.vx;this.y+=this.vy;if(this.x<0||this.x>c.width||this.y<0||this.y>c.height){this.x=Math.random()*c.width;this.y=Math.random()*c.height}var dx=this.x-mx,dy=this.y-my,d=Math.sqrt(dx*dx+dy*dy);if(d<120){this.x+=dx/d*0.5;this.y+=dy/d*0.5}};
 P.prototype.draw=function(){ctx.beginPath();ctx.arc(this.x,this.y,this.s,0,Math.PI*2);ctx.fillStyle='rgba(0,212,255,'+this.o+')';ctx.fill()};
 for(var i=0;i<120;i++)arr.push(new P());
 function animate(){ctx.clearRect(0,0,c.width,c.height);for(var i=0;i<arr.length;i++){arr[i].update();arr[i].draw()}for(var i=0;i<arr.length;i++){for(var j=i+1;j<arr.length;j++){var dx=arr[i].x-arr[j].x,dy=arr[i].y-arr[j].y,d=Math.sqrt(dx*dx+dy*dy);if(d<150){ctx.beginPath();ctx.moveTo(arr[i].x,arr[i].y);ctx.lineTo(arr[j].x,arr[j].y);ctx.strokeStyle='rgba(0,212,255,'+(0.08*(1-d/150))+')';ctx.lineWidth=0.5;ctx.stroke()}}}requestAnimationFrame(animate)}animate();
 document.addEventListener('mousemove',function(e){var r=c.getBoundingClientRect();mx=e.clientX-r.left;my=e.clientY-r.top});
 }
 function initNavbar(){
 var n=document.getElementById('navbar');window.addEventListener('scroll',function(){if(window.scrollY>50)n.classList.add('scrolled');else n.classList.remove('scrolled')});
 document.getElementById('navToggle').addEventListener('click',function(){document.getElementById('navLinks').classList.toggle('open')});
 var l=document.querySelectorAll('.nav-links a');for(var i=0;i<l.length;i++)l[i].addEventListener('click',function(){document.getElementById('navLinks').classList.remove('open')});
 }
 function initScrollReveal(){
 var els=document.querySelectorAll('.reveal');if('IntersectionObserver' in window){var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:0.1,rootMargin:'0px 0px 50px 0px'});for(var i=0;i<els.length;i++)obs.observe(els[i])}else{for(var i=0;i<els.length;i++)els[i].classList.add('visible')}
 }
function renderServices(){
  var g=document.getElementById('servicesGrid');if(!g)return;
  var services=[
    {title:'Criação de Sites Profissionais',desc:'Site completo com design profissional, alta performance, SEO, responsividade, suporte técnico e painel administrativo.',price:'R$ 1.000,00 - R$ 1.500,00'},
    {title:'E-commerce Premium',desc:'Loja virtual completa com catálogo de produtos, carrinho de compras, integração pagamento e gestão de estoque.',price:'R$ 1.500,00 - R$ 2.500,00'},
    {title:'Site de Fidelidade',desc:'Programa de fidelidade digital com app, catálogo de recompensas e integração com WhatsApp.',price:'R$ 800,00 - R$ 1.200,00'},
    {title:'Catálogo Digital',desc:'Catálogo interativo online com categorias, filtros e compartilhamento direto pelo WhatsApp.',price:'R$ 500,00 - R$ 800,00'},
    {title:'Site de Festa',desc:'Site especial para festas com convidados, cronograma, lista de presença e galeria de fotos.',price:'R$ 400,00 - R$ 600,00'},
    {title:'Site de Evento',desc:'Plataforma completa para eventos com inscrições, pagamento e painel de controle.',price:'R$ 1.200,00 - R$ 2.000,00'}
  ];
  for(var i=0;i<services.length;i++){
    var s=services[i];var card=document.createElement('div');card.className='service-card reveal';card.innerHTML='<div class="service-icon"><i class="fas fa-globe"></i></div><h3>'+s.title+'</h3><p>'+s.desc+'</p><div class="service-price">'+s.price+'</div><button class="service-btn" data-index="'+i+'"><i class="fas fa-shopping-cart"></i> Contratar</button>';g.appendChild(card);var obs=new IntersectionObserver(function(entries,obs){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:0.1});obs.observe(card);}
  }
  function initPaymentPopup(){
  var popup=document.getElementById('paymentPopup'),closeBtn=document.getElementById('popupClose'),sel=1000;
  var servicesData=[
    {title:'Criação de Sites Profissionais',desc:'Site completo com design profissional, alta performance, SEO, responsividade, suporte técnico e painel administrativo.',price:1000},
    {title:'E-commerce Premium',desc:'Loja virtual completa com catálogo de produtos, carrinho de compras, integração pagamento e gestão de estoque.',price:1500},
    {title:'Site de Fidelidade',desc:'Programa de fidelidade digital com app, catálogo de recompensas e integração com WhatsApp.',price:800},
    {title:'Catálogo Digital',desc:'Catálogo interativo online com categorias, filtros e compartilhamento direto pelo WhatsApp.',price:500},
    {title:'Site de Festa',desc:'Site especial para festas com convidados, cronograma, lista de presença e galeria de fotos.',price:400},
    {title:'Site de Evento',desc:'Plataforma completa para eventos com inscrições, pagamento e painel de controle.',price:1200}
  ];
  document.addEventListener('click',function(e){var btn=e.target.closest('.service-btn');if(!btn)return;sel=servicesData[parseInt(btn.getAttribute('data-index'))].price;
  var svc=servicesData[parseInt(btn.getAttribute('data-index'))];
  document.getElementById('popupTitle').textContent=svc.title;
  document.getElementById('popupDesc').textContent=svc.desc;
  document.getElementById('popupPrice').textContent='R$ '+sel.toFixed(2).replace('.',',');
  var opts=document.getElementById('priceOptions');opts.style.display='none';
  attPopup(sel);popup.classList.add('active');document.body.style.overflow='hidden';
  });
  document.getElementById('priceOptions').addEventListener('click',function(e){var opt=e.target.closest('.price-option');if(!opt)return;sel=parseInt(opt.getAttribute('data-price'));
  document.getElementById('popupPrice').textContent='R$ '+sel.toFixed(2).replace('.',',');
  var btns=this.querySelectorAll('.price-option');for(var k=0;k<btns.length;k++)btns[k].classList.remove('active');opt.classList.add('active');attPopup(sel);
  });
  function attPopup(price){
  document.getElementById('popupQr').src='https://api.qrserver.com/v1/create-qr-code/?size=200x200&data='+encodeURIComponent(pixKey);
  document.getElementById('comprovanteLink').href='https://wa.me/'+wpp+'etext=Ol%C3%A1!%20Vim%20pelo%20site%20da%20We%20Are%20e%20gostaria%20de%20contratar%20o%20servi%C3%A7o:%20'+encodeURIComponent(servicesData[0].title)+' (valor%20R$%20'+price.toFixed(2).replace('.',',')+').%20Segue%20comprovante%20de%20pagamento.';
  }
  closeBtn.addEventListener('click',function(){popup.classList.remove('active');document.body.style.overflow=''});
  popup.addEventListener('click',function(e){if(e.target===this){this.classList.remove('active');document.body.style.overflow=''}});
  }
 var g=document.getElementById('portfolioGrid');if(!g)return;
 for(var i=0;i<projects.length;i++){
 var p=projects[i];var card=document.createElement('div');card.className='portfolio-card reveal';card.setAttribute('data-idx',i);
 card.innerHTML='<div class="portfolio-thumb"><img src="'+p.cardImg+'" alt="'+p.name+'" loading="lazy" /><div class="overlay"><a href="#services" class="btn btn-primary" onclick="window.abrirPagina('+i+');return false">Ver Projeto</a></div></div><div class="portfolio-info"><h3>'+p.name+'</h3><p>'+p.desc+'</p><span class="tag">'+p.tagline+'</span></div>';
 card.addEventListener('click',function(){abrirPagina(parseInt(this.getAttribute('data-idx')))});
 g.appendChild(card);
 var obs=new IntersectionObserver(function(entries,obs){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:0.1});obs.observe(card);
 }
 }
 window.abrirPagina=function(idx){
 var p=projects[idx];if(!p)return;
 document.getElementById('mainContent').style.display='none';
 var ov=document.getElementById('pageOverlay');ov.classList.add('active');document.body.style.overflow='hidden';
 var pc=document.getElementById('pageContent');
 var testimonialsHTML='';for(var t=0;t<p.testimonials.length;t++){testimonialsHTML+='<div class="pg-testimonial"><div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div><p>"'+p.testimonials[t].s+'"</p><div class="author">- '+p.testimonials[t].a+'</div></div>';}
 var featsHTML='';for(var f=0;f<p.features.length;f++){featsHTML+='<div class="pg-feat"><i class="fas '+p.features[f].i+'"></i><h4>'+p.features[f].t+'</h4><p>'+p.features[f].d+'</p></div>';}
 pc.innerHTML='<div class="pg-hero" style="--accent-color:'+p.accent+'"><div class="pg-hero-bg" style="background-image:url('+p.heroImg+')"></div><div class="pg-hero-content"><div class="badge" style="background:'+p.accentGrad+';color:#fff"><i class="fas fa-star"></i> '+p.badge+'</div><h1>'+p.heroTitle+'</h1><p>'+p.heroDesc+'</p><div class="actions">'+(p.link?'<a href="'+p.link+'" target="_blank" class="btn btn-primary" style="background:'+p.accentGrad+';color:#fff">'+p.heroBtnText+' <i class="fas fa-arrow-right"></i></a>':'')+'<a href="#services" class="btn btn-outline" style="border-color:rgba(255,255,255,0.3);color:#fff" onclick="window.fecharPagina()">Quero um assim</a></div></div></div><div class="pg-section" style="--accent-color:'+p.accent+'"><div class="pg-feat-grid">'+featsHTML+'</div></div>'+p.extraHTML+'<div class="pg-section" style="--accent-color:'+p.accent+'"><h3 class="pg-section-title">O que dizem <span>nossos clientes</span></h3>'+testimonialsHTML+'</div><div class="pg-cta"><button class="btn-voltar" onclick="window.fecharPagina()"><i class="fas fa-arrow-left"></i> Voltar ao portfolio</button></div>';
 var reveals=ov.querySelectorAll('.reveal');for(var r=0;r<reveals.length;r++){if('IntersectionObserver' in window){var obs=new IntersectionObserver(function(entries,obs){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:0.1});obs.observe(reveals[r])}else{reveals[r].classList.add('visible')}}
 ov.scrollTop=0;
 // Init catalog filters
 setTimeout(function(){
 var filters=ov.querySelectorAll('.btn-filter');
 for(var f=0;f<filters.length;f++){
 filters[f].addEventListener('click',function(){
 var cat=this.getAttribute('data-cat');
 var section=this.closest('.pg-section');
 if(!section)return;
 var items=section.querySelectorAll('.catalog-item');
 var btns=section.querySelectorAll('.btn-filter');
 for(var b=0;b<btns.length;b++){
 btns[b].style.background='transparent';btns[b].style.color='';
 }
 this.style.background='var(--bg-card)';this.style.color='var(--text)';
 for(var i=0;i<items.length;i++){
 if(cat==='todos'||items[i].getAttribute('data-cat')===cat){
 items[i].style.display='';
 }else{items[i].style.display='none'}
 }
 });
 }
 },100);
 };
 window.fecharPagina=function(){document.getElementById('pageOverlay').classList.remove('active');document.getElementById('mainContent').style.display='';document.body.style.overflow='';window.scrollTo({top:0,behavior:'smooth'})};
 document.getElementById('pageFechar').addEventListener('click',window.fecharPagina);
document.getElementById('fecharPagina').addEventListener('click',window.fecharPagina);

var servicesData=[
  {title:'Criação de Sites Profissionais',desc:'Site completo com design profissional, alta performance, SEO, responsividade, suporte técnico e painel administrativo.',price:1000},
  {title:'E-commerce Premium',desc:'Loja virtual completa com catálogo de produtos, carrinho de compras, integração pagamento e gestão de estoque.',price:1500},
  {title:'Site de Fidelidade',desc:'Programa de fidelidade digital com app, catálogo de recompensas e integração com WhatsApp.',price:800},
  {title:'Catálogo Digital',desc:'Catálogo interativo online com categorias, filtros e compartilhamento direto pelo WhatsApp.',price:500},
  {title:'Site de Festa',desc:'Site especial para festas com convidados, cronograma, lista de presença e galeria de fotos.',price:400},
  {title:'Site de Evento',desc:'Plataforma completa para eventos com inscrições, pagamento e painel de controle.',price:1200}
  ];
  function initPaymentPopup(){
  var popup=document.getElementById('paymentPopup'),closeBtn=document.getElementById('popupClose'),sel=1000;
  document.addEventListener('click',function(e){var btn=e.target.closest('.service-btn');if(!btn)return;sel=servicesData[parseInt(btn.getAttribute('data-index'))].price;
  var svc=servicesData[parseInt(btn.getAttribute('data-index'))];
  document.getElementById('popupTitle').textContent=svc.title;
  document.getElementById('popupDesc').textContent=svc.desc;
  document.getElementById('popupPrice').textContent='R$ '+sel.toFixed(2).replace('.',',');
  var opts=document.getElementById('priceOptions');opts.style.display='none';
  attPopup(sel);popup.classList.add('active');document.body.style.overflow='hidden';
  });
  document.getElementById('priceOptions').addEventListener('click',function(e){var opt=e.target.closest('.price-option');if(!opt)return;sel=parseInt(opt.getAttribute('data-price'));
  document.getElementById('popupPrice').textContent='R$ '+sel.toFixed(2).replace('.',',');
  var btns=this.querySelectorAll('.price-option');for(var k=0;k<btns.length;k++)btns[k].classList.remove('active');opt.classList.add('active');attPopup(sel);
  });
  function attPopup(price){
  document.getElementById('popupQr').src='https://api.qrserver.com/v1/create-qr-code/?size=200x200&data='+encodeURIComponent(pixKey);
  document.getElementById('comprovanteLink').href='https://wa.me/'+wpp+'etext=Ol%C3%A1!%20Vim%20pelo%20site%20da%20We%20Are%20e%20gostaria%20de%20contratar%20o%20servi%C3%A7o:%20'+encodeURIComponent(servicesData[0].title)+' (valor%20R$%20'+price.toFixed(2).replace('.',',')+').%20Segue%20comprovante%20de%20pagamento.';
  }
  closeBtn.addEventListener('click',function(){popup.classList.remove('active');document.body.style.overflow=''});
  popup.addEventListener('click',function(e){if(e.target===this){this.classList.remove('active');document.body.style.overflow=''}});
  }
 function initCopyPix(){
 document.getElementById('copyPixBtn').addEventListener('click',function(){var el=this,orig=el.innerHTML;
 function fb(){var ta=document.createElement('textarea');ta.value=pixKey;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);el.innerHTML='<i class="fas fa-check"></i> Chave PIX copiada!';setTimeout(function(){el.innerHTML=orig},2000)}
 if(navigator.clipboard){navigator.clipboard.writeText(pixKey).then(function(){el.innerHTML='<i class="fas fa-check"></i> Chave PIX copiada!';setTimeout(function(){el.innerHTML=orig},2000)})['catch'](function(){fb()})}else{fb()}
 });
 }
 function initSettings(){
 var ov=document.getElementById('settingsOverlay');
 document.getElementById('settingsBtn').addEventListener('click',function(){ov.classList.add('active');document.body.style.overflow='hidden';loadUserData()});
 document.getElementById('settingsClose').addEventListener('click',function(){ov.classList.remove('active');document.body.style.overflow=''});
 ov.addEventListener('click',function(e){if(e.target===this){this.classList.remove('active');document.body.style.overflow=''}});
 var tabs=document.querySelectorAll('.settings-tab');for(var i=0;i<tabs.length;i++){tabs[i].addEventListener('click',function(){var a=document.querySelectorAll('.settings-tab');for(var j=0;j<a.length;j++)a[j].classList.remove('active');var c=document.querySelectorAll('.settings-content');for(var j=0;j<c.length;j++)c[j].classList.remove('active');this.classList.add('active');document.getElementById(this.getAttribute('data-tab')).classList.add('active')})}
 document.getElementById('goToRegister').addEventListener('click',function(e){e.preventDefault();var a=document.querySelectorAll('.settings-tab');for(var j=0;j<a.length;j++)a[j].classList.remove('active');var c=document.querySelectorAll('.settings-content');for(var j=0;j<c.length;j++)c[j].classList.remove('active');document.querySelector('[data-tab="tabRegister"]').classList.add('active');document.getElementById('tabRegister').classList.add('active')});
 document.getElementById('registerForm').addEventListener('submit',function(e){e.preventDefault();var n=document.getElementById('regName').value.trim(),em=document.getElementById('regEmail').value.trim(),ph=document.getElementById('regPhone').value.trim(),pw=document.getElementById('regPassword').value;var er=document.getElementById('regError'),sc=document.getElementById('regSuccess');er.style.display='none';sc.style.display='none';if(!n||!em||!pw||pw.length<6){er.textContent='Preencha todos os campos obrigatorios.';er.style.display='block';return}localStorage.setItem('weare_user',JSON.stringify({name:n,email:em,phone:ph,password:pw}));sc.style.display='block';this.reset();setTimeout(function(){sc.style.display='none';var a=document.querySelectorAll('.settings-tab');for(var j=0;j<a.length;j++)a[j].classList.remove('active');var c=document.querySelectorAll('.settings-content');for(var j=0;j<c.length;j++)c[j].classList.remove('active');document.querySelector('[data-tab="tabLogin"]').classList.add('active');document.getElementById('tabLogin').classList.add('active')},1500)});
 document.getElementById('loginForm').addEventListener('submit',function(e){e.preventDefault();var em=document.getElementById('loginEmail').value.trim(),pw=document.getElementById('loginPassword').value;var u=JSON.parse(localStorage.getItem('weare_user')||'{}');if(u.email===em&&u.password===pw){localStorage.setItem('weare_logged','true');document.getElementById('loginError').style.display='none';var b=this.querySelector('.btn');b.innerHTML='<i class="fas fa-check"></i> Logado!';setTimeout(function(){b.innerHTML='<i class="fas fa-sign-in-alt"></i> Entrar';var a=document.querySelectorAll('.settings-tab');for(var j=0;j<a.length;j++)a[j].classList.remove('active');var c=document.querySelectorAll('.settings-content');for(var j=0;j<c.length;j++)c[j].classList.remove('active');document.querySelector('[data-tab="tabProfile"]').classList.add('active');document.getElementById('tabProfile').classList.add('active');loadUserData()},1000)}else{document.getElementById('loginError').style.display='block'}});
 }
 function loadUserData(){
 var lg=localStorage.getItem('weare_logged')==='true',u=JSON.parse(localStorage.getItem('weare_user')||'{}');
 if(lg&&u.name){document.getElementById('profileName').value=u.name||'';document.getElementById('profileEmail').value=u.email||'';document.getElementById('profilePhone').value=u.phone||'';var hd=document.getElementById('historyList'),h=JSON.parse(localStorage.getItem('weare_history')||'[]');if(h.length===0)hd.innerHTML='<p style="color:var(--text-muted);font-size:14px">Nenhum serviço contratado ainda.</p>';else{var html='';for(var i=0;i<h.length;i++)html+='<div class="history-item"><span>'+h[i].service+'</span><span>'+h[i].date+'</span><span class="status">'+h[i].status+'</span></div>';hd.innerHTML=html}}else{document.getElementById('profileName').value='';document.getElementById('profileEmail').value='';document.getElementById('profilePhone').value='';document.getElementById('historyList').innerHTML='<p style="color:var(--text-muted);font-size:14px">Faca login para ver seus dados.</p>'}
 }
 function initDarkMode(){document.getElementById('darkModeToggle').addEventListener('click',function(){this.classList.toggle('active');document.body.classList.toggle('light-mode')})}
 function initContactForm(){document.getElementById('contactForm').addEventListener('submit',function(e){e.preventDefault();var b=this.querySelector('.btn'),o=b.innerHTML;b.innerHTML='<i class="fas fa-spinner fa-spin"></i> Enviando...';setTimeout(function(){b.innerHTML='<i class="fas fa-check"></i> Mensagem enviada!';this.reset();setTimeout(function(){b.innerHTML=o},2000)}.bind(this),1200)})}
 function initFaq(){var items=document.querySelectorAll('.faq-q');for(var i=0;i<items.length;i++){items[i].addEventListener('click',function(){var p=this.parentElement,was=p.classList.contains('active');var all=document.querySelectorAll('.faq-item');for(var j=0;j<all.length;j++)all[j].classList.remove('active');if(!was)p.classList.add('active')})}}
 function initBackTop(){document.getElementById('backTop').addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})})}
 document.addEventListener('DOMContentLoaded',init);
 })();
 </script>
</body>
</html>











