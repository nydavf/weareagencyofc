<!DOCTYPE html>
<html lang="pt-BR">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>We Are - Transformamos ideias em marcas digitais</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
 <style>

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{--primary:#00d4ff;--secondary:#8b5cf6;--accent:#6d28d9;--bg:#0a0a0f;--bg-alt:#12121a;--bg-card:#1a1a2e;--text:#fff;--text-muted:#94a3b8;--border:#1e293b;--glass:rgba(255,255,255,0.05);--shadow:0 8px 32px rgba(0,0,0,0.4);--radius:16px;--radius-sm:10px;--transition:all .4s cubic-bezier(.25,.46,.45,.94);--fp:'Poppins',sans-serif;--fs:'Inter',sans-serif}
.light-mode{--bg:#f8fafc;--bg-alt:#f1f5f9;--bg-card:#fff;--text:#0f172a;--text-muted:#475569;--border:#e2e8f0;--glass:rgba(0,0,0,0.03);--shadow:0 8px 32px rgba(0,0,0,0.08)}
html{scroll-behavior:smooth}body{font-family:var(--fs);background:var(--bg);color:var(--text);line-height:1.7;overflow-x:hidden;transition:var(--transition)}
a{text-decoration:none;color:inherit}ul{list-style:none}img{max-width:100%;display:block}
.container{max-width:1200px;margin:0 auto;padding:0 24px}section{padding:100px 0;position:relative}
.section-label{font-family:var(--fp);font-size:13px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--primary);margin-bottom:12px;display:block}
.section-title{font-family:var(--fp);font-size:clamp(28px,5vw,48px);font-weight:800;line-height:1.15;margin-bottom:20px}
.section-title span{background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.section-desc{color:var(--text-muted);font-size:17px;max-width:600px;line-height:1.8}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;border-radius:50px;font-family:var(--fp);font-weight:600;font-size:15px;border:none;cursor:pointer;transition:var(--transition);position:relative;overflow:hidden}
.btn-primary{background:linear-gradient(135deg,var(--primary),var(--secondary));color:#fff;box-shadow:0 4px 25px rgba(0,212,255,0.3)}.btn-primary:hover{transform:translateY(-5px) scale(1.04);box-shadow:0 12px 50px rgba(0,212,255,0.55)}
.btn-outline{background:transparent;color:var(--text);border:2px solid var(--border)}.btn-outline:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-5px) scale(1.04)}
.btn-whatsapp{background:#25d366;color:#fff}.btn-whatsapp:hover{background:#1da851;transform:translateY(-3px)}
#loading{position:fixed;inset:0;z-index:10000;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s,visibility .6s}#loading.hide{opacity:0;visibility:hidden;pointer-events:none}
.loader-logo{font-family:var(--fp);font-size:48px;font-weight:900;background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:30px}
.loader-bar-wrap{width:200px;height:3px;background:var(--border);border-radius:3px;overflow:hidden}
.loader-bar{height:100%;width:0;background:linear-gradient(90deg,var(--primary),var(--secondary));border-radius:3px;animation:loaderAnim 1.8s ease forwards}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
@keyframes loaderAnim{0%{width:0}50%{width:70%}100%{width:100%}}
@keyframes pgHeroIn{from{opacity:0;transform:translateY(40px) scale(0.98)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes pgZoomBadge{from{opacity:0;transform:scale(0.5) rotate(-10deg)}to{opacity:1;transform:scale(1) rotate(0)}}
@keyframes pgSlideText{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes pgZoomBg{from{transform:scale(1)}to{transform:scale(1.08)}}
@keyframes pgSectionIn{from{opacity:0;transform:translateY(60px) scale(0.97)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes pgCardPop{from{opacity:0;transform:translateY(40px) scale(0.9)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes pgBadgePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
@keyframes pgFeatFade{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes pgIconSpin{0%{transform:rotate(0) scale(1)}50%{transform:rotate(180deg) scale(1.2)}100%{transform:rotate(360deg) scale(1)}}
@keyframes pgCardSlide{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:translateX(0)}}
@keyframes pgTestimonialIn{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}
@keyframes pgTitleReveal{from{opacity:0;transform:translateY(20px) scale(0.95)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes popIn{from{transform:scale(0.9);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes wppPulse{0%,100%{box-shadow:0 4px 25px rgba(37,211,102,0.4)}50%{box-shadow:0 4px 45px rgba(37,211,102,0.7)}}
@keyframes zoomIn{from{opacity:0;transform:scale(0.8)}}
@keyframes zoomOut{from{opacity:0;transform:scale(1.2)}}
@keyframes float{0%,100%{transform:translateY(0) rotate(0deg)}}
@keyframes floatSlow{0%,100%{transform:translateY(0) rotate(2deg)}}
@keyframes morph{0%,100%{border-radius:40% 60% 70% 30% 50% 40% 60% 30%;}}
@keyframes pulse{0%,100%{transform:scale(1);filter:brightness(1)}50%{transform:scale(1.05);filter:brightness(1.1)}}
@keyframes slideLeft{from{opacity:0;transform:translateX(-50px)}}
@keyframes slideRight{from{opacity:0;transform:translateX(50px)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}}
@keyframes rotate{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pgHeroIn{from{opacity:0;transform:translateY(40px) scale(0.98)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes pgZoomBadge{from{opacity:0;transform:scale(0.5) rotate(-10deg)}to{opacity:1;transform:scale(1) rotate(0)}}
@keyframes pgSlideText{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes pgZoomBg{from{transform:scale(1)}to{transform:scale(1.08)}}
.pg-section{opacity:0;animation:pgSectionIn 0.8s cubic-bezier(0.16,1,0.3,1) forwards;animation-delay:0.3s}
.pg-section:nth-child(2){animation-delay:0.2s}.pg-section:nth-child(3){animation-delay:0.4s}.pg-section:nth-child(4){animation-delay:0.6s}.pg-section:nth-child(5){animation-delay:0.8s}
@keyframes pgSectionIn{from{opacity:0;transform:translateY(60px) scale(0.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.catalog-item{opacity:0;animation:pgCardPop 0.6s cubic-bezier(0.16,1,0.3,1) forwards;transform-origin:center bottom}
.catalog-item:nth-child(1){animation-delay:0.05s}.catalog-item:nth-child(2){animation-delay:0.1s}.catalog-item:nth-child(3){animation-delay:0.15s}.catalog-item:nth-child(4){animation-delay:0.2s}.catalog-item:nth-child(5){animation-delay:0.25s}.catalog-item:nth-child(6){animation-delay:0.3s}.catalog-item:nth-child(7){animation-delay:0.35s}.catalog-item:nth-child(8){animation-delay:0.4s}.catalog-item:nth-child(9){animation-delay:0.45s}.catalog-item:nth-child(10){animation-delay:0.5s}.catalog-item:nth-child(11){animation-delay:0.55s}.catalog-item:nth-child(12){animation-delay:0.6s}
@keyframes pgCardPop{from{opacity:0;transform:translateY(40px) scale(0.9)}to{opacity:1;transform:translateY(0) scale(1)}}
.catalog-item{transition:all 0.4s cubic-bezier(0.16,1,0.3,1)}.catalog-item:hover{transform:translateY(-12px) scale(1.02);box-shadow:0 24px 64px rgba(0,0,0,0.4)}.catalog-item img{transition:transform 0.6s cubic-bezier(0.16,1,0.3,1)}.catalog-item:hover img{transform:scale(1.12)}.catalog-item .badge-overlay{position:absolute;top:10px;left:10px;z-index:1;animation:pgBadgePulse 2s ease-in-out infinite}
@keyframes pgBadgePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
.pg-feat{opacity:0;animation:pgFeatFade 0.6s ease forwards;transform:translateY(20px)}.pg-feat:nth-child(1){animation-delay:0.1s}.pg-feat:nth-child(2){animation-delay:0.2s}.pg-feat:nth-child(3){animation-delay:0.3s}.pg-feat:nth-child(4){animation-delay:0.4s}.pg-feat:nth-child(5){animation-delay:0.5s}.pg-feat:nth-child(6){animation-delay:0.6s}
@keyframes pgFeatFade{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.pg-feat:hover i{animation:pgIconSpin 0.6s ease}.pg-feat i{transition:all 0.3s ease}
@keyframes pgIconSpin{0%{transform:rotate(0) scale(1)}50%{transform:rotate(180deg) scale(1.2)}100%{transform:rotate(360deg) scale(1)}}
.pg-card,.pg-price-card{opacity:0;animation:pgCardSlide 0.6s cubic-bezier(0.16,1,0.3,1) forwards}
.pg-card:nth-child(1),.pg-price-card:nth-child(1){animation-delay:0.08s}.pg-card:nth-child(2),.pg-price-card:nth-child(2){animation-delay:0.16s}.pg-card:nth-child(3),.pg-price-card:nth-child(3){animation-delay:0.24s}.pg-card:nth-child(4),.pg-price-card:nth-child(4){animation-delay:0.32s}.pg-card:nth-child(5),.pg-price-card:nth-child(5){animation-delay:0.4s}.pg-card:nth-child(6),.pg-price-card:nth-child(6){animation-delay:0.48s}
@keyframes pgCardSlide{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:translateX(0)}}
.pg-price-card{transition:all 0.4s cubic-bezier(0.16,1,0.3,1)}.pg-price-card:hover{transform:translateY(-10px) scale(1.03);box-shadow:0 24px 64px rgba(0,0,0,0.4)}.pg-price-card.popular{transform:scale(1.05)}.pg-price-card.popular:hover{transform:scale(1.08) translateY(-5px)}
.pg-testimonial{opacity:0;animation:pgTestimonialIn 0.6s ease forwards;transform:translateX(-20px)}.pg-testimonial:nth-child(1){animation-delay:0.1s}.pg-testimonial:nth-child(2){animation-delay:0.3s}
@keyframes pgTestimonialIn{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}
.btn-filter{transition:all 0.3s cubic-bezier(0.16,1,0.3,1)}.btn-filter:hover{transform:translateY(-2px) scale(1.05)}.btn-filter.active{transform:scale(1.05);box-shadow:0 4px 16px rgba(0,0,0,0.3)}
.pg-section-title{animation:pgTitleReveal 0.8s ease forwards;opacity:0;transform:translateY(20px)}
@keyframes pgTitleReveal{from{opacity:0;transform:translateY(20px) scale(0.95)}to{opacity:1;transform:translateY(0) scale(1)}}
.modalidade-item,.agenda-item{opacity:0;animation:pgCardPop 0.5s ease forwards}
.modalidade-item:nth-child(1){animation-delay:0.05s}.modalidade-item:nth-child(2){animation-delay:0.1s}.modalidade-item:nth-child(3){animation-delay:0.15s}.modalidade-item:nth-child(4){animation-delay:0.2s}.modalidade-item:nth-child(5){animation-delay:0.25s}.modalidade-item:nth-child(6){animation-delay:0.3s}.modalidade-item:nth-child(7){animation-delay:0.35s}.modalidade-item:nth-child(8){animation-delay:0.4s}
.btn-voltar{transition:all 0.3s ease}.btn-voltar:hover{transform:scale(1.05);box-shadow:0 8px 24px rgba(0,0,0,0.3)}
.pg-price-card{background:var(--bg-card);border:2px solid var(--border);border-radius:var(--radius);padding:30px;text-align:center;transition:var(--transition);position:relative}.pg-price-card.popular{border-color:var(--accent-color,var(--primary))}.pg-price-card.popular::before{content:'POPULAR';position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--accent-color,var(--primary));color:#fff;font-size:11px;font-weight:700;padding:4px 16px;border-radius:50px;letter-spacing:1px}
.pg-price-card h3{font-family:var(--fp);font-size:18px;font-weight:700;margin-bottom:8px}.pg-price-card .price{font-family:var(--fp);font-size:32px;font-weight:800;color:var(--accent-color,var(--primary));margin-bottom:16px}.pg-price-card .price small{font-size:14px;font-weight:400;color:var(--text-muted)}
.pg-price-card ul{list-style:none;margin-bottom:20px}.pg-price-card ul li{padding:8px 0;border-bottom:1px solid var(--border);font-size:14px;color:var(--text-muted)}.pg-price-card ul li i{color:var(--accent-color,var(--primary));margin-right:8px}
.pg-price-card .btn{width:100%;justify-content:center}
footer{background:var(--bg-alt);border-top:1px solid var(--border);padding:60px 0 30px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px}footer h3{font-family:var(--fp);font-size:20px;font-weight:700;margin-bottom:16px}footer h4{font-weight:600;font-size:16px;margin-bottom:14px;color:var(--text)}footer p{color:var(--text-muted);font-size:14px;line-height:1.8;max-width:320px}footer ul li{margin-bottom:10px}footer ul li a{color:var(--text-muted);font-size:14px;transition:var(--transition)}footer ul li a:hover{color:var(--primary)}
.footer-social{display:flex;gap:12px;margin-top:16px}.footer-social a{width:40px;height:40px;border-radius:50%;background:var(--glass);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--text-muted);transition:var(--transition)}.footer-social a:hover{background:var(--primary);color:#fff;border-color:var(--primary)}
.footer-bottom{border-top:1px solid var(--border);padding-top:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}.footer-bottom p{font-size:13px;color:var(--text-muted)}
.back-top{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));color:#fff;border:none;cursor:pointer;font-size:16px;transition:var(--transition)}.back-top:hover{transform:translateY(-5px);box-shadow:0 8px 30px rgba(0,212,255,0.3)}
.whatsapp-float{position:fixed;bottom:24px;right:24px;z-index:999;width:60px;height:60px;border-radius:50%;background:#25d366;color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 4px 25px rgba(37,211,102,0.4);transition:var(--transition);animation:wppPulse 2s ease-in-out infinite}.whatsapp-float:hover{transform:scale(1.1);box-shadow:0 8px 40px rgba(37,211,102,0.6)}
@keyframes wppPulse{0%,100%{box-shadow:0 4px 25px rgba(37,211,102,0.4)}50%{box-shadow:0 4px 45px rgba(37,211,102,0.7)}}
.popup-overlay{position:fixed;inset:0;z-index:10001;background:rgba(0,0,0,0.7);backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;padding:20px}.popup-overlay.active{display:flex}
.popup{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);max-width:440px;width:100%;padding:40px 32px;position:relative;animation:popIn .3s ease}@keyframes popIn{from{transform:scale(0.9);opacity:0}to{transform:scale(1);opacity:1}}
.popup-close{position:absolute;top:16px;right:16px;width:32px;height:32px;border-radius:50%;background:var(--glass);border:1px solid var(--border);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition)}.popup-close:hover{background:var(--primary);color:#fff}
.popup h3{font-family:var(--fp);font-size:22px;font-weight:700;margin-bottom:6px}.popup .popup-price{font-size:32px;font-weight:800;color:var(--primary);margin:12px 0}.popup .popup-desc{color:var(--text-muted);font-size:14px;margin-bottom:20px}
.price-option.active{border-color:var(--primary);background:rgba(0,212,255,0.1);color:var(--primary)}
.popup .qr-wrap{display:flex;justify-content:center;margin:20px 0}.popup .qr-wrap img{width:200px;height:200px;border-radius:12px;background:#fff;padding:8px}
.popup .pix-key-info{text-align:center;margin:16px 0}.popup .pix-key-info p{font-size:13px;color:var(--text-muted);margin-bottom:8px}
.popup .popup-actions{display:flex;flex-direction:column;gap:10px}.popup .popup-actions .btn{justify-content:center;width:100%}
.popup .popup-after-pay{text-align:center;margin-top:16px;padding:14px;background:var(--glass);border-radius:var(--radius-sm);font-size:14px;color:var(--text-muted)}
.settings-overlay{position:fixed;inset:0;z-index:10002;background:rgba(0,0,0,0.7);backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;padding:20px}.settings-overlay.active{display:flex}
.settings-panel{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);max-width:520px;width:100%;max-height:90vh;overflow-y:auto;padding:40px 32px;position:relative;animation:popIn .3s ease}
.settings-panel h2{font-family:var(--fp);font-size:24px;font-weight:700;margin-bottom:20px}
.settings-tabs{display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap}.settings-tab{padding:8px 18px;border-radius:50px;border:1px solid var(--border);background:transparent;color:var(--text-muted);cursor:pointer;font-size:13px;font-weight:500;transition:var(--transition);font-family:var(--fs)}.settings-tab.active{background:var(--primary);color:#fff;border-color:var(--primary)}.settings-tab:hover:not(.active){border-color:var(--primary);color:var(--text)}
.settings-content{display:none}.settings-content.active{display:block}
.settings-form{display:flex;flex-direction:column;gap:14px}.settings-form input{padding:12px 16px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:var(--fs);font-size:15px;outline:none;transition:var(--transition)}.settings-form input:focus{border-color:var(--primary)}.settings-form .btn{justify-content:center;width:100%}.settings-form .error{color:#ef4444;font-size:13px;display:none}.settings-form .success-msg{color:#22c55e;font-size:14px;text-align:center;padding:12px;background:rgba(34,197,94,0.1);border-radius:var(--radius-sm);display:none}
.settings-history{display:flex;flex-direction:column;gap:10px}.history-item{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--glass);border-radius:var(--radius-sm);border:1px solid var(--border);font-size:14px}.history-item .status{font-size:12px;padding:4px 12px;border-radius:50px;background:rgba(34,197,94,0.15);color:#22c55e}
.settings-panel .toggle-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border)}.toggle-row span{font-size:15px}
.toggle-switch{width:48px;height:26px;border-radius:13px;background:var(--border);cursor:pointer;position:relative;transition:var(--transition)}.toggle-switch::after{content:'';position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:var(--text);transition:var(--transition)}.toggle-switch.active{background:var(--primary)}.toggle-switch.active::after{left:25px;background:#fff}
.reveal{opacity:0;transform:translateY(40px);transition:opacity .8s ease,transform .8s ease}.reveal.visible{opacity:1;transform:translateY(0)}
@media(max-width:992px){.hero-grid{grid-template-columns:1fr;text-align:center;gap:40px}.hero-sub{margin-left:auto;margin-right:auto}.hero-actions{justify-content:center}.about-wrap{grid-template-columns:1fr;text-align:center}.about-stats{justify-items:center}.contact-wrap{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr;gap:30px}.hero-visual{order:-1}.hero-card-float{display:none}}
@media(max-width:768px){section{padding:60px 0}.nav-links{display:none;position:fixed;top:70px;left:20px;right:20px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;flex-direction:column;gap:16px;z-index:9998;box-shadow:var(--shadow)}.nav-links.open{display:flex}.nav-toggle{display:flex}.footer-grid{grid-template-columns:1fr;gap:24px}.services-grid{grid-template-columns:1fr}.testimonials-grid{grid-template-columns:1fr}.settings-panel{padding:24px 16px}.portfolio-grid{grid-template-columns:1fr}}
@media(max-width:480px){.container{padding:0 16px}.hero-actions{flex-direction:column;align-items:stretch}.hero-actions .btn{justify-content:center}}

</style>
</head>
<body>
 <div id="loading">
 <div class="loader-logo">WE ARE</div>
 <div class="loader-bar-wrap"><div class="loader-bar"></div></div>
 <div class="loader-text">CARREGANDO...</div>
 </div>

 <nav class="navbar" id="navbar">
 <div class="container">
 <a href="#hero" class="nav-logo"><img src="logo%20we%20are.jpeg" alt="We Are" />WE<span>ARE</span></a>
 <ul class="nav-links" id="navLinks">
 <li><a href="#hero">Home</a></li>
 <li><a href="#about">Sobre</a></li>
 <li><a href="#services">Serviço</a></li>
 <li><a href="#portfolio">Portfolio</a></li>
 <li><a href="#testimonials">Depoimentos</a></li>
 <li><a href="#faq">FAQ</a></li>
 <li><a href="#contact">Contato</a></li>
 </ul>
 <div class="nav-actions">
 <button class="nav-settings" id="settingsBtn" title="Configurações"><i class="fas fa-cog"></i></button>
 <button class="nav-toggle" id="navToggle" title="Menu"><i class="fas fa-bars"></i></button>
 </div>
 </div>
 </nav>

 <main id="mainContent">
 <section id="hero">
 <canvas id="particles-canvas"></canvas>
 <div class="container">
 <div class="hero-grid">
 <div class="hero-text">
 <div class="hero-badge"><i class="fas fa-rocket"></i> Agência de Serviços Digitais</div>
 <h1 class="hero-title">Transformamos ideias em <span>marcas digitais</span> profissionais.</h1>
 <p class="hero-sub">Sites profissionais para empresas que querem crescer online.</p>
 <div class="hero-actions">
